              "file": "app/__init__.py",
              "patch": "Index: app/__init__.py\n===================================================================\n--- app/__init__.py\t\n+++ app/__init__.py\t\n@@ -0,0 +1,26 @@\n+from flask import Flask, jsonify, request\n+\n+\n+def create_app():\n+    app = Flask(__name__)\n+    items = []\n+\n+    @app.get(\"/health\")\n+    def health():\n+        return jsonify(status=\"ok\")\n+\n+    @app.post(\"/items\")\n+    def add_item():\n+        data = request.get_json(silent=True) or {}\n+        name = data.get(\"name\")\n+        if not name:\n+            return jsonify(error=\"name is required\"), 400\n+        item = {\"id\": len(items) + 1, \"name\": name}\n+        items.append(item)\n+        return jsonify(item), 201\n+\n+    @app.get(\"/items\")\n+    def list_items():\n+        return jsonify(items)\n+\n+    return app\n",
              "additions": 26,
              "deletions": 0,
              "status": "added"
            },
            {
              "file": "requirement.txt",
              "patch": "Index: requirement.txt\n===================================================================\n--- requirement.txt\t\n+++ requirement.txt\t\n@@ -0,0 +1,2 @@\n+flask\n+pytest\n",
